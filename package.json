{
  "name": "three-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An atlas of interactive 3D worlds and creative experiments for the web.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5194 --strictPort",
    "check": "node scripts/check.mjs",
    "audit": "npm audit --registry=https://registry.npmjs.org",
    "test": "node --test tests/*.test.js experiences/*/tests/*.test.js",
    "test:browser": "playwright test",
    "build": "node scripts/check-content.mjs && vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4194 --strictPort",
    "prebuild": "node scripts/media.mjs",
    "perf": "npm run build && node scripts/perf.mjs",
    "new:work": "node scripts/new-work.mjs",
    "test:visual": "playwright test --config=playwright.visual.config.js",
    "test:compat": "playwright test --config=playwright.compat.config.js",
    "test:transitions": "npm run build && playwright test --config=playwright.production.config.js",
    "predev": "node scripts/media.mjs --dev"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.58.0",
    "sharp": "0.35.5",
    "vite": "8.3.5"
  },
  "overrides": {
    "basic-ftp": "6.2.6",
    "glob@>=9": "14.0.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
